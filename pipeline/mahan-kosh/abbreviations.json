  "grammar_annotations": {
    "_convention": "Recurring grammatical frames written in full words rather than the dash-marker system. These are phrase patterns; each 'frame' below uses X for the referenced word.",
    "entries": [
      { "frame": "X ਦਾ ਬਹੁਵਚਨ / X ਦਾ ਬਹੁ ਵਚਨ", "english": "plural of X", "attribute": "number=plural", "source": "corpus" },
      { "frame": "ਸੰਬੋਧਨ", "english": "vocative (often 'ਸੰਬੋਧਨ. ਹੇ ...!')", "attribute": "case=vocative", "source": "corpus" },
      { "frame": "X ਕ੍ਰਿਯਾ ਦਾ ਅਮਰ", "english": "imperative of verb X", "attribute": "mood=imperative", "source": "corpus", "note": "ਅਮਰ alone is also an ordinary word (immortal); require the frame" },
      { "frame": "ਭੂਤ ਕਾਲ (ਬੋਧਕ)", "english": "past tense (indicator)", "attribute": "tense=past", "source": "corpus" },
      { "frame": "ਵਰਤਮਾਨ", "english": "present tense", "attribute": "tense=present", "source": "corpus" },
      { "frame": "ਇਸਤ੍ਰੀ ਲਿੰਗ", "english": "feminine gender", "attribute": "gender=feminine", "source": "corpus", "note": "ਇਸਤ੍ਰੀ alone is usually the gloss 'woman'; require the ਲਿੰਗ frame" },
      { "frame": "ਪੁਲਿੰਗ", "english": "masculine gender", "attribute": "gender=masculine", "source": "corpus" },
      { "frame": "X ਦਾ ਸੰਖੇਪ", "english": "short form / abbreviation of X", "attribute": "lexical=short_form_of", "source": "corpus" }
    ]
  },

