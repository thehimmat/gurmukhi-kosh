# The radio streaming server (thehimmat/google-home-radiocaster, streaming-server/selfhost/), which
# runs on this VM as its own Compose project and shares only the radio-edge network with this gateway.
# Without that stack running, these two names answer 502 and nothing else is affected.
(radio) {
	reverse_proxy radio:3001 {
		# Pass audio bytes on as they arrive instead of buffering them.
		flush_interval -1
	}
}

# Proxied by Cloudflare in Full (strict) mode, like search.caddy, so CF-Connecting-IP can be trusted.
stream.atthebunga.com {
	import cloudflare_origin
	import radio
}

# Let's Encrypt, not through Cloudflare: for testing before cutover, and to rule Cloudflare in or out
# when chasing a problem. Nothing is in front of this name, so any CF-Connecting-IP here is the
# caller's own invention. Replace it with the real address, which the server's logs read it from.
radio.{$SITE_ADDRESS} {
	request_header Cf-Connecting-Ip {remote_host}
	import radio
}
