# SITE_ADDRESS is ":8000" locally; on the server it's the API's domain, and Caddy fetches its TLS
# certificate itself.
{$SITE_ADDRESS} {
	# Supabase's gateway refuses any request whose apikey isn't one of the project's keys. Same here,
	# so the API answers nobody who hasn't loaded one of the apps. Preflights carry no apikey.
	# The bearer token must be a current key too, or absent (PostgREST then uses anon): a replaced
	# key is still validly signed, so this is what retires it.
	@preflight method OPTIONS
	@keyed expression `({header.apikey} == "{$ANON_KEY}" || {header.apikey} == "{$SERVICE_KEY}") && ({header.Authorization} == "" || {header.Authorization} == "Bearer {$ANON_KEY}" || {header.Authorization} == "Bearer {$SERVICE_KEY}")`

	handle_path /rest/v1/* {
		handle @preflight {
			reverse_proxy rest:3000
		}
		handle @keyed {
			reverse_proxy rest:3000
		}
		handle {
			header Content-Type application/json
			respond `{"message":"Invalid API key"}` 401
		}
	}

	# The latest nightly backup (encrypted; scripts/backup.sh) for .github/workflows/backup.yml to
	# copy offsite. Only that one file, behind a random token from .env.
	handle /backups/{$BACKUP_TOKEN}/latest.dump.gpg {
		root * /srv/backups
		rewrite * /latest.dump.gpg
		file_server
	}

	# For uptime checks: 200 only when PostgREST is up and reaches the database. No apikey needed;
	# it says nothing but up or down.
	handle /health {
		rewrite * /ready
		reverse_proxy rest:3001
	}

	handle {
		respond 404
	}
}
